# Required services
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/learning_qa?sslmode=require
DASHSCOPE_API_KEY=
DEEPSEEK_API_KEY=

# Authentication (generate with: python -c "import secrets; print(secrets.token_hex(32))")
JWT_SECRET=
REGISTRATION_ENABLED=true
AUTH_COOKIE_SECURE=false
FRONTEND_ORIGIN=http://localhost:5173

# Vector store and models
MILVUS_URI=http://localhost:19530
MILVUS_TOKEN=
MILVUS_DATABASE=rag_tutorial
MILVUS_COLLECTION=rag_docs_hybrid_v1_1024
MEMORY_COLLECTION=rag_user_memories_v1_1024
EMBEDDING_MODEL=text-embedding-v4
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.5:9b
DEFAULT_MODEL_PROVIDER=deepseek

# Optional integrations
WEB_SEARCH_ENABLED=false
TAVILY_API_KEY=
SCRAPLING_TIMEOUT=15
SCRAPLING_MAX_CHARACTERS=12000
# 默认不按 RRF 分数触发联网；如需启用，先用本地评估集校准后取消下一行注释。
# AUTO_WEB_HYBRID_SCORE_THRESHOLD=0.02
MINERU_ENABLED=false
MINERU_API_TOKEN=
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
