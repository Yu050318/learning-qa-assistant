# Required services
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/learning_qa?sslmode=require
DASHSCOPE_API_KEY=
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash

# Authentication (generate with: python -c "import secrets; print(secrets.token_hex(32))")
JWT_SECRET=
REGISTRATION_ENABLED=true
# Optional reusable admin invitation. Empty disables admin self-registration.
# Existing accounts stay ordinary users unless explicitly migrated.
ADMIN_INVITE_CODE=
AUTH_COOKIE_SECURE=false
FRONTEND_ORIGIN=http://localhost:5173

# Vector store and models
MILVUS_URI=http://localhost:19530
MILVUS_TOKEN=
MILVUS_DATABASE=rag_tutorial
MILVUS_COLLECTION=rag_docs_hybrid_v1_1024
MEMORY_COLLECTION=rag_user_memories_v1_1024
EMBEDDING_MODEL=text-embedding-v4
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.5:9b
DEFAULT_MODEL_PROVIDER=deepseek

# Optional integrations
WEB_SEARCH_ENABLED=false
TAVILY_API_KEY=
SCRAPLING_TIMEOUT=15
SCRAPLING_MAX_CHARACTERS=12000
MINERU_ENABLED=false
MINERU_API_TOKEN=
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=

# Supervisor: one shared model/tool budget across all agents (including repairs/fallback)
AGENT_MAX_MODEL_CALLS=16
AGENT_MAX_TOOL_CALLS=12
# Optional bounded private-KB planning / grading; one rewrite across the whole request
KNOWLEDGE_QUALITY_ENABLED=false
AGENT_MAX_KNOWLEDGE_CALLS=3
SUPERVISOR_MAX_DELEGATIONS=6
SUPERVISOR_MAX_PER_AGENT=2

# Independent PostgreSQL business database: dedicated SELECT-only role, never the platform DB
# Leave empty to disable SQL execution. Whitelist uses explicit schema.table names.
SQL_DATABASE_URL=
SQL_ALLOWED_TABLES=["sales.orders","sales.products"]
SQL_SOURCE_NAME=业务数据库
SQL_TIMEOUT=5
SQL_MAX_ROWS=100

# Retrieve small chunks first, then read bounded same-source context (no reindex needed)
RETRIEVAL_PARENT_CONTEXT=true
RETRIEVAL_PARENT_GROUP_SIZE=4

# Opt-in after: python -m app.bootstrap --hierarchy (additive PostgreSQL table only)
# New ingestion: recursive root/parent/leaf; existing documents need an explicit single-document backfill.
HIERARCHY_ENABLED=false
HIERARCHY_MERGE_THRESHOLD=0.6

# Opt-in after: python -m app.bootstrap --document-versions (additive tables only)
DOCUMENT_VERSIONS_ENABLED=false

# Opt-in after: python -m app.bootstrap --ingestion-jobs
# All API/Worker processes must use durable mode and the same upload/parsed directories.
INGESTION_MODE=in_process
INGESTION_LEASE_SECONDS=120
INGESTION_MAX_ATTEMPTS=3
INGESTION_POLL_SECONDS=2

# Opt-in after: python -m app.migrate, then start python -m app.run_worker.
# API prepares/queues only. Completed model/tool receipts support fenced recovery.
CHAT_RUNS_ENABLED=false
CHAT_RUN_WORKERS=4
CHAT_RUN_QUEUE_LIMIT=32
CHAT_RUN_LEASE_SECONDS=45
CHAT_RUN_WAIT_SECONDS=1800

# Opt-in after: python -m app.bootstrap --sharing
SHARING_ENABLED=false

# Opt-in after: python -m app.bootstrap --model-center
# Legacy migration input ONLY: python -m app.migrate --model-admins
# Runtime administration uses the persistent user.role, never this list.
MODEL_CENTER_ENABLED=false
MODEL_ADMIN_USERNAMES=[]

# Optional DashScope text rerank (explicit opt-in; sends bounded candidate text to this endpoint)
RERANK_ENABLED=false
# Copy the full HTTPS endpoint for your workspace/region from the provider console.
RERANK_ENDPOINT=
RERANK_MODEL=gte-rerank-v2
RERANK_API_KEY=
RERANK_TIMEOUT=5

# Durable evaluation workbench; migrate and deploy python -m app.evaluation_worker before enabling.
EVALUATION_ENABLED=false
EVALUATION_QUEUE_LIMIT=8
EVALUATION_LEASE_SECONDS=45
